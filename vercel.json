{
  "redirects": [
    {
      "source": "/catalogue",
      "destination": "/products/leather",
      "permanent": true
    },
    {
      "source": "/products/chappals",
      "destination": "/products/leather",
      "permanent": true
    },
    {
      "source": "/products",
      "destination": "/products/leather",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
